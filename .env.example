# Copy this file to .env and replace every placeholder with a local value.
# Never commit .env.

POSTGRES_DB=EventHubDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

JWT_ISSUER=EventHubApi
JWT_AUDIENCE=EventHubClient
JWT_SECRET_KEY=replace-with-a-long-random-secret-key

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_NAME=EventHub Support
SMTP_SENDER_EMAIL=replace-with-sender@example.com
SMTP_PASSWORD=replace-with-smtp-app-password
EMAIL_VERIFICATION_URL=http://localhost:8080/api/Auth/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

DATABASE_APPLY_MIGRATIONS=true
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
